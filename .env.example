FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=   # REQUIRED in production: 64+ random chars, e.g. python -c "import secrets;print(secrets.token_hex(32))"
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=info@maximnyansa.com
ADMIN_EMAIL=admin@maximnyansa.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Cloudinary (recommended for persistent uploads on Render free tier)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack (optional — enables real payments)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Production hardening (see Security_and_Resilience_Review.md)
SITE_URL=https://your-domain.example
ALLOWED_HOSTS=your-domain.example
TRUSTED_PROXY_COUNT=1
RATELIMIT_STORAGE_URI=            # redis://:password@host:6379/0 in production
PAYSTACK_CURRENCY=                # currency of your Paystack account, e.g. NGN, GHS, USD
WEB_CONCURRENCY=2

# --- added by security review ---
SITE_URL=https://your-site.example.com
ALLOWED_HOSTS=your-site.example.com
TRUSTED_PROXY_COUNT=1
RATELIMIT_STORAGE_URI=memory://   # use a redis:// URL in production
PAYSTACK_CURRENCY=
