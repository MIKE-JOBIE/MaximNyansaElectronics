# LOCAL DEVELOPMENT ONLY. Never paste production secrets into this file or commit .env.
FLASK_ENV=development
SECRET_KEY=dev-only-change-this-local-secret-key-before-use
DATABASE_URL=sqlite:///dev.db

# Initial local admin created by "flask seed". Use a unique local password.
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=ChangeThisLocalAdminPassword123!

# SMTP is optional locally. Without credentials, emails are printed as development previews.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.local

# Leave Cloudinary blank for local uploads. Production must configure all three values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local rate limiting; production should use a shared Redis/Valkey service.
RATELIMIT_STORAGE_URI=memory://

# Configure the real account currency before testing Paystack. Never use live keys locally.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_TEST_MODE=true
PAYSTACK_CURRENCY=

SITE_URL=http://127.0.0.1:5000
ALLOWED_HOSTS=
TRUSTED_PROXY_COUNT=0
MAINTENANCE_SECRET=
